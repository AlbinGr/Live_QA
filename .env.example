# Public, browser-safe values from Supabase Project Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Optional. Useful behind a proxy or when the public URL differs from the browser origin.
# Do not add a trailing slash.
VITE_PUBLIC_APP_URL=
